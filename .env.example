# OptiCore Device Client - Configuration Example
# Copy this file to .env and update with your actual values

# Server Configuration
OPTICORE_SERVER_URL=https://your-ngrok-url.ngrok-free.dev
OPTICORE_CLIENT_ID=opticore-client-1

# Web Dashboard Configuration
HOST=127.0.0.1
PORT=5050

# Camera Configuration
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
STREAM_FPS=10
JPEG_QUALITY=80

# Optional: Use video file instead of camera (for testing)
# VIDEO_FILE_PATH=/path/to/video.mp4

# TTS Configuration
TTS_ENABLED=true
TTS_RATE=175
TTS_VOLUME=0.8
ALERT_COOLDOWN_SECONDS=5
ALERT_VERBOSITY=normal

# Groq Configuration (Optional)
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=5
GROQ_MAX_TOKENS=150
GROQ_COOLDOWN_SECONDS=30
GROQ_MAX_INPUT_TOKENS=500

# WebSocket Configuration
WS_MAX_RECONNECT_DELAY=30
WS_INITIAL_RECONNECT_DELAY=1
WS_TIMEOUT=10

# Frame Buffer Configuration
FRAME_BUFFER_SIZE=2
